MARKET_MODE="real"

# real 模式必填：运行 `openssl rand -base64 32` 生成，实际值只写入 .env.local 或密钥服务。
# CONTACT_ENCRYPTION_KEY="<32-byte-base64-key>"

# 可选：覆盖默认的 ./data/rental.sqlite 与 ./data/uploads。
# RENTAL_DATABASE_PATH="/absolute/path/to/rental.sqlite"
# RENTAL_UPLOAD_DIRECTORY="/absolute/path/to/uploads"

SILICONFLOW_API_KEY_FILE="/absolute/path/to/siliconflow-api-key.txt"
SILICONFLOW_MODEL="Qwen/Qwen3.5-35B-A3B"

# 可选：AI 请求基础超时（毫秒，默认 45000）。实际超时会按本次请求的
# maxTokens 动态放大（每 1000 tokens 追加约 9s，上限 180s）。
# 供应商变慢时调这里，不要改代码。
# SILICONFLOW_TIMEOUT_MS=45000

# 可选：频控上限。服务端会再应用内置硬上限，避免误配置关闭保护。
# RATE_SESSION_IP_MINUTE=10
# RATE_WRITE_IP_MINUTE=60
# RATE_WRITE_PROFILE_MINUTE=30
# RATE_WRITE_PROFILE_DAY=1000
# RATE_AI_IP_MINUTE=10
# RATE_AI_SESSION_MINUTE=6
# RATE_AI_PROFILE_HOUR=30
# RATE_AI_PROFILE_DAY=100
# RATE_AI_GLOBAL_DAY=1000
